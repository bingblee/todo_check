DATABASE_PATH=./data/todo.sqlite
# Public URL used for deployment documentation and cookie protocol detection.
# Use the real browser-facing URL in production, e.g. https://todo.example.com.
APP_URL=http://localhost:3000
# Only set this when a reverse proxy mounts the app below a public prefix,
# such as https://example.com/todo/. Do not use /app (that is an app route).
APP_BASE_PATH=
# Must be unique when several apps share one domain or server host.
AUTH_COOKIE_NAME=todo_check_session
# Set explicitly when the proxy protocol cannot be detected:
# AUTH_COOKIE_SECURE=true for HTTPS, false for HTTP.
AUTH_COOKIE_SECURE=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_DAILY_LIMIT=10
